# Python / venv / caches
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache

# Secrets & local env. certbot/ holds the DNS-provider API credentials; the
# certbot container reads them via a host bind mount (docker-compose.prod.yml),
# so the app image must never carry them. The *.env glob is deliberate: only
# `.env` was listed, so scripts/backup_db.env rode into every image built while
# it existed, carrying a real host, user and SSH port.
.env
*.env
**/*.env
certbot/

# Generated at build time (tailwind + collectstatic), never copy stale copies in
staticfiles

# Local data / backups not needed at runtime. old-results/ is 46 MB of real
# past-event data — nothing reads it, and it has no business in a published image.
captures/
old-results/

# VCS / docker meta
.git
.dockerignore

# Docs & notes (none read at runtime)
*.md
docs/
TODO.md
# …except the admin-console guides + screenshots, which the builder renders to
# PDF via `manage.py build_docs_pdf` before collectstatic.
!docs/admin-console
!docs/admin-console/**

# Tests
mahj/tests/

# Superseded assets
*_old.*

# Local-only load-test / query-profiling tooling and its output
locustfile.py
test_*.sh
run.log
run_*.csv
