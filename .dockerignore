.git
.dockerignore

# Docs & notes (none read at runtime)
*.md
docs/
TODO.md

# Tests
mahj/tests/

# Superseded assets
*_old.*

# Local-only load-test / query-profiling tooling and its output
locustfile.py
test_*.sh
run.log
run_*.csv
