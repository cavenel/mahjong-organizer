gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 1000;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

proxy_cache_path /var/cache/nginx/desktop
                 levels=1:2
                 keys_zone=desktop_cache:10m
                 max_size=200m
                 inactive=10m
                 use_temp_path=off;

upstream django {
    server unix:/run/gunicorn/mahjong.sock;
}

# HTTP — redirect everything to HTTPS; keep ACME challenge reachable for renewals
server {
    listen 80;
    server_name *.${BASE_DOMAIN} ${BASE_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name *.${BASE_DOMAIN} ${BASE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BASE_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # ---------------------------------------------------------------------------
    # TOPOLOGY ASSUMPTION: this nginx is the OUTERMOST proxy for *.${BASE_DOMAIN}.
    #
    # The tenant subdomains are A records pointing straight at this host; only the
    # apex and www go through OVH's redirector. So $remote_addr below is the real
    # client, and the X-Forwarded-For this block sets is authoritative — which is
    # what the scan upload limiter relies on to key its per-device buckets
    # (mahj/views/scan.py:_upload_allowed).
    #
    # IF A PROXY OR CDN IS EVER PUT IN FRONT of this host, $remote_addr becomes that
    # proxy's address and every scan collapses into one bucket — six uploads and the
    # whole venue is throttled mid-event. Restore the real client first, in one place,
    # rather than teaching the app to count hops:
    #
    #   set_real_ip_from <the proxy's CIDR>;
    #   real_ip_header   X-Forwarded-For;
    #   real_ip_recursive on;
    #
    # after which $remote_addr is the client again and the header below stays correct.
    # ---------------------------------------------------------------------------

    # One limit for the whole app, above the widest thing it accepts: scan photos
    # (8 MB, enforced in the view), a 2 MB logo, an Excel template import and a
    # tournament dump on the restore page. nginx's 1 MB default rejected most of
    # those before Django ever saw them — with a bare 413 the pages can't explain.
    # The per-endpoint caps live in the app, where the message belongs.
    client_max_body_size 20m;

    # Static files served directly — bypasses Django for production traffic
    location /static/ {
        alias /app/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # WebSocket connections (Django Channels)
    location /ws/ {
        proxy_pass http://django;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
    }

    # Homepage: microcache for anonymous viewers.
    # Logged-in users (auth=1 cookie set by AuthCookieMiddleware) bypass — they need live data.
    location = / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;

        proxy_cache       desktop_cache;
        proxy_cache_key   "$scheme$host$request_uri$http_accept_encoding";
        proxy_cache_valid 200 20s;

        # Django sends `Vary: Cookie` on / (the auth-cookie middleware reads the
        # session every request). Honoring it fragments this microcache per unique
        # Cookie value, so any viewer carrying a cookie (analytics, a stray
        # csrftoken, …) MISSes to origin — defeating the cookie-less cache key above
        # and letting a crowd stampede the (synchronous, ~8-at-a-time) desktop view.
        # Ignore Vary so all non-staff viewers share one entry. Safe: anonymous /
        # sets no Set-Cookie, and authenticated staff bypass via $cookie_auth below.
        # We do NOT ignore Set-Cookie, so nginx's "never cache a Set-Cookie response"
        # safety net stays intact if / ever starts setting one.
        proxy_ignore_headers Vary;

        proxy_cache_bypass $cookie_auth;
        proxy_no_cache     $cookie_auth;

        proxy_cache_lock         on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale    updating error timeout http_500 http_502 http_503;

        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Score-sheet scan uploads: staging the image and enqueuing the OCR job takes
    # longer than an ordinary request, so these get their own read timeout. The
    # page posts to scan_<round>_<table>, so match the prefix, not just /scan.
    location ~ ^/scan(_\d+_\d+)?$ {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # All other requests → Gunicorn (no cache)
    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}

# Reject anything that isn't *.${BASE_DOMAIN} (direct-IP, scanners, stale vhosts)
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BASE_DOMAIN}/privkey.pem;

    return 444;
}
