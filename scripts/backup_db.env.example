# Off-host backup config for scripts/backup_db.sh
#
# Copy to scripts/backup_db.env (gitignored) and fill in your remote.
# DB credentials are NOT here — the script reads them from the project .env.
#
# NOTE: backup_db.sh runs on the HOST (from cron), not inside a container. It
# only reaches into the db container via `docker compose exec` to run pg_dump;
# the dump file, the rsync, and the SSH key all live on the host. So the paths
# below (SSH_KEY, LOCAL_DIR) are HOST paths, owned by the user that runs cron.

# Where the rsync'd dumps land. Format: user@host:/absolute/path
# The remote directory must already exist.
REMOTE="backup@my-second-box.example.com:/srv/mahj-backups"

# HOST path to the SSH private key, readable by the user whose crontab runs this
# (your login user → /home/<you>/.ssh/...; root's cron → /root/.ssh/...).
# Passphrase-less, so cron is unattended. Generate one dedicated to backups and
# authorize it on the remote (run these on the HOST, as the cron user):
#   ssh-keygen -t ed25519 -f ~/.ssh/mahj_backup -N ''
#   ssh-copy-id -i ~/.ssh/mahj_backup.pub backup@my-second-box.example.com
SSH_KEY="/home/youruser/.ssh/mahj_backup"

# SSH port of the remote, if it's not 22.
# SSH_PORT=19022

# Origin label baked into every dump name: mahj_<BACKUP_SOURCE>_<stamp>.dump.
# Set this DIFFERENTLY on each box so cloud and venue dumps never collide in the
# shared remote dir and failback can pick the right one. Defaults to the hostname.
#   on the VPS:    BACKUP_SOURCE="cloud"
#   on the laptop: BACKUP_SOURCE="venue"
BACKUP_SOURCE="cloud"

# --- optional overrides (sensible defaults in backup_db.sh) -------------------
# Local dump directory (outside the Docker volume).
# LOCAL_DIR="/opt/mahj-backups"
# How the stack is invoked, so `exec db` finds the running container.
# COMPOSE="docker compose -f docker-compose.yml -f docker-compose.prod.yml"
# Keep local dumps this many minutes (default 720 = 12h).
# LOCAL_RETENTION_MIN=720
# Keep remote dumps this many minutes (default 4320 = 3 days).
# REMOTE_RETENTION_MIN=4320
