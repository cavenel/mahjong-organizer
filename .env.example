# Copy to .env and fill in values before deploying.
# manage.py defaults to apps.settings.dev (no .env needed for local dev).
# Production requires DJANGO_SETTINGS_MODULE=apps.settings.prod plus all vars below.

DJANGO_SETTINGS_MODULE=apps.settings.prod

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated list of domains, e.g. mahj.ovh,www.mahj.ovh
ALLOWED_HOSTS=mahj.ovh

# Venue wall-clock timezone for the live clock on the projector standings screen
# (IANA name). The server stores everything in UTC; this only sets what local
# time the display clock renders. Defaults to UTC if unset.
#   VENUE_TZ=Europe/Stockholm
VENUE_TZ=Europe/Stockholm

# PostgreSQL connection (required in all environments)
# Django connects through pgbouncer; pgbouncer connects to the db service.
DB_NAME=mahj
DB_USER=mahj
DB_PASSWORD=
DB_HOST=pgbouncer
DB_PORT=5432

# PgBouncer tuning (optional; defaults are applied in docker-compose.yml)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=300
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Emergency local instance ONLY (DEBUG/dev settings): pin every request to one
# tenant by subdomain, so a venue laptop reached at a bare LAN IP serves the live
# tournament instead of the dev tenant. Leave unset in the cloud (prod ignores it).
#   LOCAL_TENANT=varberg
# LOCAL_TENANT=

# Optional webhook: POST leaderboard JSON to an external site on publish/unpublish.
# Leave WEBHOOK_URL unset to disable entirely.
#   WEBHOOK_URL     — endpoint to POST to
#   WEBHOOK_SECRET  — sent as the X-Webhook-Secret header (optional)
#   WEBHOOK_TENANT  — restrict firing to ONE tenant (a subdomain, like LOCAL_TENANT).
#                     Every tenant shares WEBHOOK_URL, so without this a test
#                     tenant's publishes would post to the live site. Unset = all
#                     tenants fire.
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# WEBHOOK_TENANT=

# Optional static publish: on each round publish, render the public spectator
# page (/ + player/team/table modals) to static files and SFTP-upload them to a
# plain web host. Leave PUBLISH_SFTP_HOST unset to disable. Also re-runnable from
# the admin console ("Publish to web").
#   PUBLISH_SFTP_HOST     — target host (unset = disabled)
#   PUBLISH_SFTP_PORT     — default 22
#   PUBLISH_SFTP_USER     — ssh user
#   PUBLISH_SFTP_KEY      — path to a private key (preferred), or
#   PUBLISH_SFTP_PASSWORD — password auth
#   PUBLISH_SFTP_PATH     — remote directory the site is served from
#   PUBLISH_SFTP_KNOWN_HOSTS — known_hosts file to pin the host key (else auto-add)
#   PUBLISH_TENANT        — restrict to ONE tenant (subdomain), like WEBHOOK_TENANT
# PUBLISH_SFTP_HOST=
# PUBLISH_SFTP_PORT=22
# PUBLISH_SFTP_USER=
# PUBLISH_SFTP_KEY=
# PUBLISH_SFTP_PASSWORD=
# PUBLISH_SFTP_PATH=/var/www/mahj
# PUBLISH_SFTP_KNOWN_HOSTS=
# PUBLISH_TENANT=

# Redis (defaults to localhost; in Docker use the service name)
# REDIS_URL     — Django cache (allkeys-lru, disposable)
# REDIS_BUS_URL — Channels layer + scan queue (separate noeviction instance, so
#                 the cache's LRU can't evict a live socket's group membership).
#                 Falls back to REDIS_URL if unset (single-instance dev).
REDIS_URL=redis://redis:6379/1
REDIS_BUS_URL=redis://redis_bus:6379/0

# In-app database restore (admin console → Database restore). See scripts/DB_RESTORE.md.
#   MAHJ_BACKUP_DIR    — host dir holding the dumps, mounted into web (ro) + restore_worker
#                        (rw). Defaults to /opt/mahj-backups (same as scripts/backup_db.sh).
# MAHJ_BACKUP_DIR=/opt/mahj-backups
#   restore_worker runs as this uid:gid — set it to the OWNER of MAHJ_BACKUP_DIR
#   and the SSH key (run `id -u`/`id -g`) so pull can write dumps + read the key
#   without chowning host files. Default 1000 (the image's app user).
# MAHJ_WORKER_UID=1000
# MAHJ_WORKER_GID=1000
#   The "Pull from remote" button — mirror the values from scripts/backup_db.env.
#   Leave BACKUP_REMOTE unset to hide/disable pull (restore still works locally).
#   MAHJ_BACKUP_SSH_KEY should be a group-readable COPY of the backup key, NOT the
#   cron's own key (ssh refuses a group-readable key owned by you → breaks backups):
#     cp ~/.ssh/mahj_backup ~/.ssh/mahj_backup.container && chmod 640 ~/.ssh/mahj_backup.container
# BACKUP_REMOTE=cavenel@host:/srv/mahj-backups
# BACKUP_SSH_PORT=19022
# MAHJ_BACKUP_SSH_KEY=/home/cavenel/.ssh/mahj_backup.container
