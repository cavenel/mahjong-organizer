# Copy to .env and fill in values before deploying.
# manage.py defaults to apps.settings.dev (no .env needed for local dev).
# Production requires DJANGO_SETTINGS_MODULE=apps.settings.prod plus all vars below.
# docker-compose.prod.yml sets it itself; this line covers manage.py run by hand on
# the server. A plain `docker compose up` with only docker-compose.yml is the DEV
# stack (dev settings, bound to 127.0.0.1) — always pass both -f files in prod.

DJANGO_SETTINGS_MODULE=apps.settings.prod

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# The apex domain this instance is served under. Tenants live at
# <subdomain>.<BASE_DOMAIN>. Drives CSRF trusted origins, the nginx vhost
# (server_name + TLS cert path at /etc/letsencrypt/live/<BASE_DOMAIN>/), the
# default ALLOWED_HOSTS, and the advertised spectator-site URL. Requires a
# wildcard DNS record (*.<BASE_DOMAIN>) and a wildcard TLS cert.
BASE_DOMAIN=example.org

# Comma-separated allowed Host header values. Optional — defaults to
# BASE_DOMAIN and all its subdomains. Setting it REPLACES that default, so
# include the apex and the ".example.org" wildcard yourself or every tenant
# subdomain answers 400, e.g. example.org,.example.org,www.example.org
# Extra hosts are not added to CSRF_TRUSTED_ORIGINS (derived from BASE_DOMAIN
# only), so logging in from an extra host fails with a 403.
# ALLOWED_HOSTS=

# Optional OCR: score-sheet photo scanning uses the Anthropic API. Leave unset
# to disable scanning (manual score entry is unaffected). See docs on cost.
# ANTHROPIC_API_KEY=

# Venue wall-clock timezone for the live clock on the projector standings screen
# (IANA name). The server stores everything in UTC; this only sets what local
# time the display clock renders. Defaults to UTC if unset.
#   VENUE_TZ=Europe/Stockholm
VENUE_TZ=Europe/Stockholm

# PostgreSQL connection (required in all environments)
# Django connects through pgbouncer; pgbouncer connects to the db service.
DB_NAME=mahj
DB_USER=mahj
DB_PASSWORD=
DB_HOST=pgbouncer
DB_PORT=5432

# PgBouncer tuning (optional; defaults are applied in docker-compose.yml)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=300
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Redis (defaults to localhost; in Docker use the service name)
# REDIS_URL     — Django cache (allkeys-lru, disposable)
# REDIS_BUS_URL — Channels layer + scan queue (separate noeviction instance, so
#                 the cache's LRU can't evict a live socket's group membership).
#                 Falls back to REDIS_URL if unset (single-instance dev).
REDIS_URL=redis://redis:6379/1
REDIS_BUS_URL=redis://redis_bus:6379/0

# Backups are per-tenant tournament dumps, written by the app and uploaded to the
# tenant's publish target on every publish (admin console → Backup & restore).
# Nothing to configure here: the target lives in the database, per tenant.
